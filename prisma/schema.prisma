generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reviews      Review[]
  statuses     UserWorkStatus[]
  favorites    Favorite[]
  lists        List[]
  diaryEntries DiaryEntry[]
  reviewLikes  ReviewLike[]
}

model Work {
  id            String           @id @default(cuid())
  originalTitle String
  category      String
  year          Int?
  coverUrl      String?
  tags          String[]         @default([])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?
  reviews       Review[]
  statuses      UserWorkStatus[]
  favorites     Favorite[]
  listItems     ListItem[]
  diaryEntries  DiaryEntry[]

  @@index([originalTitle])
  @@index([category])
}

model Review {
  id        String       @id @default(cuid())
  rating    Float
  content   String
  hasSpoiler Boolean     @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  workId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  likes     ReviewLike[]

  @@unique([userId, workId])
  @@index([workId])
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
}

// WANT_TO_WATCH | WATCHING | COMPLETED | ON_HOLD | DROPPED
model UserWorkStatus {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  status    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, status])
  @@index([workId])
}

model Favorite {
  id       String @id @default(cuid())
  userId   String
  workId   String
  position Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@unique([userId, workId])
  @@index([userId])
}

model List {
  id          String     @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]

  @@index([userId])
}

model ListItem {
  id       String @id @default(cuid())
  listId   String
  workId   String
  position Int    @default(0)
  note     String?
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([listId, workId])
  @@index([listId])
}

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  watchedAt DateTime @default(now())
  isRewatch Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([workId])
}
